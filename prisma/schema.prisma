generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id // Supabase Auth UUID
  email           String            @unique
  chzzkChannelId  String?
  plan            String            @default("FREE")
  aiCredits       Int               @default(50)
  minCheeseAmount Int               @default(1000) // 이 금액 미만 후원은 상황판에 올리지 않는다
  createdAt       DateTime          @default(now())
  briefings       Briefing[]
  markers         HighlightMarker[]
}

/// 방송 연결 시각 기준의 편집 타임스탬프. 채팅 원문은 저장하지 않는다.
model HighlightMarker {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestampSec  Int
  formattedTime String // 01:24:15
  reason        String
  createdAt     DateTime @default(now())
}

/// 후원 한 줄 또는 레이더 알림. 시청자 누적 기록은 두지 않는다.
model Briefing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "DONATION" | "RADAR"
  title     String
  summary   String // 35자 이내
  signal    String? // "SPIKE" | "QUESTION" | "ISSUE" | "COACHING"
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
}
