generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String     @id // Supabase Auth UUID
  email          String     @unique
  chzzkChannelId  String?
  plan            String     @default("FREE")
  aiCredits       Int        @default(50)
  minCheeseAmount Int        @default(1000) // 이 금액 미만 후원은 누적만 하고 브리핑하지 않는다
  enableFirstChat Boolean    @default(false) // 처음 등록된 시청자의 첫 채팅만 브리핑한다
  streamTone      String     @default("친근한 반말")
  streamContext   String? // 방송 컨셉 메모
  createdAt      DateTime   @default(now())
  viewers        Viewer[]
  briefings      Briefing[]
}

model Viewer {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userIdHash  String // 치지직 고유 유저 식별 해시
  nickname    String
  totalCheese Int        @default(0)
  visitCount  Int        @default(1)
  aiSummary   String? // LLM이 요약한 시청자 특징 (1~2줄)
  lastSeenAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  briefings   Briefing[]

  @@unique([userId, userIdHash])
}

model Briefing {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewerId         String
  viewer           Viewer   @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  triggerType      String // "CHEESE" | "NEW_VIEWER" | "RETURNING"
  triggerMessage   String
  cheeseAmount     Int      @default(0)
  summarySnapshot  String // 당시 시청자 요약
  suggestedReplies Json // string[] 형태의 추천 멘트 2~3개
  isPinned         Boolean  @default(false)
  isDone           Boolean  @default(false)
  createdAt        DateTime @default(now())
}
