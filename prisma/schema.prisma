generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String     @id // Supabase Auth UUID
  email           String     @unique
  chzzkChannelId  String?
  plan            String     @default("FREE")
  aiCredits       Int        @default(50)
  minCheeseAmount Int        @default(1000) // 이 금액 미만 후원은 누적만 하고 상황판에 올리지 않는다
  createdAt       DateTime   @default(now())
  viewers         Viewer[]
  briefings       Briefing[]
}

model Viewer {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userIdHash  String // 치지직 고유 유저 식별 해시
  nickname    String
  totalCheese Int        @default(0)
  visitCount  Int        @default(1)
  storyMemo   String? // 이 시청자의 과거 후원 사연을 40자 안으로 압축한 기억
  lastSeenAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  briefings   Briefing[]

  @@unique([userId, userIdHash])
}

model Briefing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewerId        String? // 익명 후원은 시청자와 연결하지 않는다
  viewer          Viewer?  @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  triggerType     String // "CHEESE"
  triggerMessage  String
  cheeseAmount    Int      @default(0)
  viewerStory     String? // 이 후원 시점의 시청자 누적 서사
  contextSummary  String? // 후원 직전 채팅과 후원 이유 한 줄
  isPinned        Boolean  @default(false)
  isDone          Boolean  @default(false)
  createdAt       DateTime @default(now())
}
